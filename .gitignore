# Terraform
.terraform/
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.*
.terraform.lock.hcl
.tfplan
*.tfplan

# Terraform variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Terraform crash logs
crash.log

# Terraform overrides
override.tf
override.tf.json
*_override.tf

# k3d / kube (local kubeconfig, port-forward pids)
.k3d_kubeconfig
.k3d_port_forward.pid
.k3d_*
.kube/
.kube/config

# Image tarballs / imports
.ingress-images.tar
.nginx_image.tar
*.tar

# Docker
docker-compose.override.yml
docker-compose.*.yml
docker-compose.*.yaml
*.log

# Logs
*.log
*.log.*
run_deploy.log
terraform_apply.log
terraform_deploy_target.log

# SSL / certs / keys (sensitive)
certs/
ssl/
*.crt
*.key
*.pem

# Editor / OS files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Backup / temp files
*.bak
*.tmp
*.orig

# Language runtime / package manager
node_modules/
npm-debug.log
yarn-error.log
__pycache__/
*.pyc

# Misc
.env
.env.*
.history

# Ignore any generated credentials or secrets files
*.secret
secrets.yml

# Allow explicit inclusion via negate patterns as needed
# !/path/to/keep
