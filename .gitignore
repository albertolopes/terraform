# Terraform
.terraform/
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.*
.terraform.lock.hcl
*.tfplan
*.tfplan.*

# Terraform variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Terraform crash logs
crash.log

# Terraform overrides
override.tf
override.tf.json
*_override.tf

# Kubernetes / k3d kubeconfigs and tooling
.k3d_kubeconfig
.k3d_port_forward.pid
.k3d_*
.kube/
.kube/config
.kubeconfig

# Local cluster volumes and image tarballs (do NOT commit local data)
volume/
volume/**
*.tar
.ingress-images.tar
.nginx_image.tar
.postgres_image.tar

# Docker / Compose local overrides
docker-compose.override.yml
docker-compose.*.local.yml

# Scripts outputs / temp files
*.tmp
*.temp
*.bak
*.orig
*.swp
*.swo
*.log
*.out
*.pid
/tmp/

# Editor/IDE
.idea/
.vscode/
*.iml
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Secrets, certificates, keys, env files
*.pem
*.key
*.crt
certs/
ssl/
.env
.env.*
secrets.yml
*.secret

# Package managers and build artifacts
node_modules/
npm-debug.log
yarn-error.log
pip-wheel-metadata/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Logs, reports
coverage/
reports/
*.lcov

# Ignore generated kube artifacts cache or local-only manifests
.k8s/

# Ignore local runtime sockets and state
*.sock
*.lock

# Ignore miscellaneous
.history
*.cache

# Keep tracked directories for k8s manifests and scripts
# (do not ignore /k8s or /scripts so manifests remain versioned)
!k8s/
!scripts/

# Explicitly ignore terraform plan output files (requested)
*.tfplan

# End of file
